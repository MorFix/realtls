{
    "name": "realtls",
    "version": "0.0.0",
    "private": true,
    "description": "Monorepo for realtls — perform TLS 1.3 + HTTP/2 exactly like a real browser from Node/TypeScript.",
    "type": "module",
    "license": "MIT",
    "author": "MorFix",
    "packageManager": "pnpm@10.25.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MorFix/realtls.git"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "typecheck": "pnpm -r run typecheck",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:live": "REALTLS_LIVE=1 vitest run",
        "check": "pnpm run lint && pnpm run typecheck && vitest run"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "koffi"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
