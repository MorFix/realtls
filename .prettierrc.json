{
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.yml", "*.yaml", "*.json", "*.md"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": "package.json",
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
